  },
  "subjects": [
    {
      "subject": "mathematics",
      "label": "Grade 6 Mathematics",
      "basis": "Common Core Grade 6 Mathematics is the primary organizing reference. Texas Grade 6 TEKS are used as an alignment/cross-check for transferability.",
      "internal_source": "https://github.com/Smarticus81/smarticus/blob/main/curriculum/2026-27/reference/01-subjects/mathematics-6.md",
      "sources": [
        {
          "label": "Common Core State Standards — Grade 6 Mathematics",
          "organization": "Common Core State Standards Initiative",
          "url": "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf",
          "role": "Primary standards reference"
        },
        {
          "label": "Texas Curriculum Standards / TEKS",
          "organization": "Texas Education Agency",
          "url": "https://tea.texas.gov/curriculum-and-instruction/curriculum-standards/curriculum-standards",
          "role": "Texas alignment cross-check"
        }
      ],
      "sequence": [
        {
          "unit": 1,
          "title": "Number Operations and Fluency",
          "topics": [
            "Fraction multiplication/division review and application",
            "Decimal multiplication/division",
            "Multi-digit computation and estimation",
            "GCF/LCM and distributive reasoning as needed"
          ]
        },
        {
          "unit": 2,
          "title": "Ratios and Rates",
          "topics": [
            "Ratio language and representations",
            "Equivalent ratios and tables",
            "Unit rates",
            "Double number lines / coordinate representations"
          ]
        },
        {
          "unit": 3,
          "title": "Percent",
          "topics": [
            "Percent as rate per 100",
            "Fraction/decimal/percent connections",
            "Percent of a quantity",
            "Finding whole, part, or percent in Grade 6 contexts"
          ]
        },
        {
          "unit": 4,
          "title": "Rational Numbers",
          "topics": [
            "Positive and negative numbers in context",
            "Number line and absolute value",
            "Ordering rational numbers",
            "Coordinate plane in all quadrants"
          ]
        },
        {
          "unit": 5,
          "title": "Expressions",
          "topics": [
            "Exponents and order of operations",
            "Variables and expressions",
            "Equivalent expressions and distributive property",
            "Evaluating expressions"
          ]
        },
        {
          "unit": 6,
          "title": "Equations and Inequalities",
          "topics": [
            "One-step and simple multi-step equations appropriate to Grade 6",
            "Meaning of equality",
            "Inequalities and solution sets",
            "Real-world modeling"
          ]
        },
        {
          "unit": 7,
          "title": "Geometry",
          "topics": [
            "Area of triangles, quadrilaterals, and polygons",
            "Volume of rectangular prisms",
            "Surface area and nets",
            "Coordinate geometry applications"
          ]
        },
        {
          "unit": 8,
          "title": "Statistics",
          "topics": [
            "Statistical questions",
            "Dot plots, histograms, and box plots as appropriate",
            "Mean/median and variability",
            "Describe distributions in context"
          ]
        },
        {
          "unit": 9,
          "title": "Cumulative Problem Solving & Readiness",
          "topics": [
            "Mixed Grade 6 applications",
            "Reasonableness and precision",
            "Cumulative mastery checks",
            "Grade 7 readiness"
          ]
        }
      ]
    },
