generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subject {
  mathematics
  literature
  writing
  science
  history_geography
  french
  computer_science
  pe
  art_design
}

enum LessonStatus {
  scheduled
  started
  in_progress
  completed
  not_assessed
}

enum MasteryStatus {
  not_assessed
  developing
  proficient
  mastered
  needs_reteach
}

enum RecordType {
  AI_OBSERVATION
  OFFICIAL_GRADE
}

enum IngestionStatus {
  pending
  processing
  completed
  failed
  skipped
}

enum AttendanceStatus {
  present
  absent
  partial
}

model Student {
  id            String   @id @default(cuid())
  internalId    String   @unique @default(cuid())
  preferredName String   @default("Atticus")
  gradeLevel    Int      @default(6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schoolYears        SchoolYear[]
  assignments        Assignment[]
  submissions        Submission[]
  assessments        Assessment[]
  masteryRecords     MasteryRecord[]
  attendanceRecords  AttendanceRecord[]
  teacherFeedback    TeacherFeedback[]
  tutorSessions      TutorSession[]
  misconceptions     Misconception[]
  portfolioArtifacts PortfolioArtifact[]
}

model SchoolYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id           String     @id @default(cuid())
  subject      Subject
  title        String
  description  String     @default("")
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  units        Unit[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([schoolYearId, subject])
}

model Unit {
  id          String   @id @default(cuid())
  externalId  String
  title       String
  description String   @default("")
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, externalId])
}

model Lesson {
  id                  String       @id @default(cuid())
  externalId          String       @unique
  date                DateTime     @db.Date
  schoolYear          String
  gradeLevel          Int
  subject             Subject
  course              String
  unitId              String
  unit                Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitTitle           String
  lessonNumber        Int
  lessonTitle         String
  standards           Json         @default("[]")
  previousLearning    String       @db.Text
  courseContext       String       @db.Text
  learningObjectives  Json         @default("[]")
  whyItMatters        String       @db.Text
  vocabulary          Json         @default("[]")
  writtenInstruction  String       @db.Text
  workedExamples      Json         @default("[]")
  guidedPractice      Json         @default("[]")
  independentPractice Json         @default("[]")
  exitTicket          Json         @default("[]")
  masteryThreshold    Float        @default(75)
  materials           Json         @default("[]")
  estimatedMinutes    Int
  voicePrompt         String       @db.Text
  teacherNotes        String       @db.Text @default("")
  answerKey           Json         @default("{}")
  sourceReferences    Json         @default("[]")
  status              LessonStatus @default(scheduled)
  dayNumber           Int?
  todaysGoal          String?
  checksum            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  assignments     Assignment[]
  assessments     Assessment[]
  masteryRecords  MasteryRecord[]
  tutorSessions   TutorSession[]
  misconceptions  Misconception[]
  teacherFeedback TeacherFeedback[]

  @@index([date])
  @@index([subject])
}

model Assignment {
  id          String    @id @default(cuid())
  externalId  String    @unique
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  instructions String   @db.Text
  dueDate     DateTime? @db.Date
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?    @db.Text
  score        Float?
  recordType   RecordType @default(AI_OBSERVATION)
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Assessment {
  id         String     @id @default(cuid())
  lessonId   String
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title      String
  score      Float?
  maxScore   Float?
  recordType RecordType @default(AI_OBSERVATION)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items AssessmentItem[]
}

model AssessmentItem {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  externalId   String
  prompt       String     @db.Text
  studentAnswer String?   @db.Text
  correctAnswer String    @db.Text
  score        Float?
  recordType   RecordType @default(AI_OBSERVATION)
  attemptRecorded Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MasteryRecord {
  id         String        @id @default(cuid())
  lessonId   String?
  lesson     Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject
  standard   String
  score      Float?
  status     MasteryStatus @default(not_assessed)
  recordType RecordType    @default(AI_OBSERVATION)
  evidence   String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([studentId, subject])
  @@index([standard])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus @default(present)
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
}

model TeacherFeedback {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  subject   Subject?
  content   String   @db.Text
  date      DateTime @default(now()) @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TutorSession {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  summary      String?  @db.Text
  transcript   Json?
  retainTranscript Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events TutorSessionEvent[]
}

model TutorSessionEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String
  payload   Json
  createdAt DateTime     @default(now())
}

model Misconception {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept   String
  note      String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioArtifact {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  content     String?  @db.Text
  filePath    String?
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SourceDocument {
  id              String          @id @default(cuid())
  filename        String
  sourceType      String
  sourcePath      String          @unique
  checksum        String          @unique
  openaiFileId    String?
  vectorStoreFileId String?
  indexingStatus  IngestionStatus @default(pending)
  metadata        Json            @default("{}")
  ingestedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model IngestionJob {
  id          String          @id @default(cuid())
  sourcePath  String
  checksum    String
  status      IngestionStatus @default(pending)
  message     String?         @db.Text
  metadata    Json            @default("{}")
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([checksum])
  @@index([sourcePath])
}

model ParentSetting {
  id                   String   @id @default(cuid())
  retainTranscripts    Boolean  @default(true)
  masteryThresholdHigh Float    @default(90)
  masteryThresholdLow  Float    @default(75)
  currentLessonId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GradeAudit {
  id         String     @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  reason     String     @db.Text
  changedBy  String     @default("parent")
  createdAt  DateTime   @default(now())
}

model DailyReview {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
