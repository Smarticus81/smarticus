NODE_ENV=development
PORT=3000

# Required for live voice sessions. Never commit a real key.
OPENAI_API_KEY=
# Full-duplex voice model (GPT-Live) and the reasoning model it delegates to.
REALTIME_MODEL=gpt-live-1
# Keep REALTIME_VOICE, GEMINI_LIVE_VOICE and GROK_VOICE the same kind of voice
# (all female by default: marin, Kore and eve), or Virgil switches voice when a
# reconnect lands on another provider.
REALTIME_VOICE=marin
LIVE_BACKEND_MODEL=gpt-6-astra
LIVE_BACKEND_REASONING=low
WEB_SEARCH_MODEL=gpt-5.6
OPENAI_VECTOR_STORE_ID=

# Free fallback tutor, used only when the OpenAI voice budget runs out.
# Leave GEMINI_API_KEY empty to disable it; the studio then reports the quota
# error instead of switching. PRIVACY: on Google's free tier the conversation
# (a child's voice and schoolwork) may be used to train their models. Use a paid
# Gemini key, or leave this empty, if that is not acceptable.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Set false if the configured model rejects search alongside function tools.
GEMINI_ENABLE_SEARCH=true
GEMINI_MAX_SESSIONS=2

# Second fallback tutor (xAI Grok Voice), tried when Gemini cannot start either.
# Leave XAI_API_KEY empty to disable it.
XAI_API_KEY=
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE=eve
GROK_ENABLE_SEARCH=true
GROK_MAX_SESSIONS=2

# Third fallback tutor (an ElevenLabs agent), tried when neither of the above
# can start. Needs both values: set ELEVENLABS_API_KEY, run
# `npm run elevenlabs:agent` to create the Virgil agent with the studio's tools,
# then paste the printed agent id here. Leave either empty to disable it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: a voice id to use instead of the agent's own, and a language model
# name (as ElevenLabs lists them) instead of the agent's own.
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=
ELEVENLABS_MAX_SESSIONS=2

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atticus_tutor
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value-before-production
SESSION_MAX_AGE_MS=604800000
# Required in production; use a unique password with at least 12 characters.
APP_ACCESS_PASSWORD=
# Parent-only grades/curriculum/transcript dashboard code. Keep private.
PARENT_ACCESS_CODE=

# Set true only when requests arrive through a trusted reverse proxy.
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
# Keep enabled so new or changed lesson files are synchronized automatically.
AUTO_INGEST_CURRICULUM=true
