{
  "title": "Atticus Grade 6 Master Curriculum — 2026–27",
  "description": "The full parent-directed Grade 6 scope and sequence Smarticus uses to generate daily lessons, pace instruction, and decide when to review or advance.",
  "disclaimer": "Smarticus is not a state-issued or accredited-school curriculum. It is a parent-directed Texas homeschool curriculum aligned to published standards and curriculum frameworks. The official links below identify the standards/frameworks used; the Smarticus sequence is the course design built from them.",
  "texas_context": {
    "label": "Texas homeschool context",
    "note": "Texas Education Agency does not approve or accredit homeschool programs. Smarticus keeps a written, standards-referenced curriculum and academic record for transfer/admissions review.",
